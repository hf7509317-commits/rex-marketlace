NODE_ENV=development
DATABASE_URL=postgresql://rexmarket:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/rexmarket?schema=public
PORT=3000
WEB_ORIGIN=http://localhost:5173
STORAGE_ROOT=./storage
# 64 hexadecimal characters from: openssl rand -hex 32. Back this up securely!
DELIVERY_ENCRYPTION_KEY=
# Bot is separate from API. Use one polling instance only.
TELEGRAM_BOT_TOKEN=
SUPER_ADMIN_TELEGRAM_ID=
# Optional SMTP; reset routes return 503 if absent. Never use fake credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
